# Node Agent Configuration
# Copy this file to .env and customize

# Server Configuration
NODE_AGENT_PORT=8911
NODE_AGENT_HOST=0.0.0.0

# Repository Configuration
REPOS_BASE_PATH=/home/ubuntu/repos
DEFAULT_REPOSITORY=main-repo

# Doppler Configuration (for Claude Code)
DOPPLER_PROJECT=seed
DOPPLER_CONFIG=prd

# GitHub Configuration (for Pull Request creation)
# Create token: https://github.com/settings/tokens
# Scopes needed: repo, public_repo
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: Max concurrent Ralph loops per node
# MAX_CONCURRENT_LOOPS=4

# ============================================================================
# PM Daemon Configuration
# ============================================================================

# Enable PM Daemon on this node (only one node should have this enabled)
# Set to "true" to run the PM daemon services on this node-agent
PM_DAEMON_ENABLED=false

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Allowed Telegram chat ID (your personal chat ID)
# Message @userinfobot on Telegram to get your chat ID
# TELEGRAM_CHAT_ID=123456789

# Optional: PM Monitor Configuration
# PM_MONITOR_INTERVAL_MS=30000 (30 seconds)
# PM_STALL_THRESHOLD_MINUTES=10 (Ralph considered stalled after 10 min of no activity)

# Optional: Nodes configuration path (default: src/config/nodes.yaml)
# NODES_CONFIG_PATH=/path/to/nodes.yaml
