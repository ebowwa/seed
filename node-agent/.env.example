# Node Agent Configuration
# Copy this file to .env and customize

# Server Configuration
NODE_AGENT_PORT=8911
NODE_AGENT_HOST=0.0.0.0

# Repository Configuration
REPOS_BASE_PATH=/home/ubuntu/repos
DEFAULT_REPOSITORY=main-repo

# Doppler Configuration (for Claude Code)
DOPPLER_PROJECT=seed
DOPPLER_CONFIG=prd

# Optional: Max concurrent Ralph loops per node
# MAX_CONCURRENT_LOOPS=4
