{
  "name": "seed-setup-v2",
  "version": "2.0.0",
  "description": "Fast, reliable environment setup powered by Bun",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "seed-setup": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile seed-setup",
    "build:linux": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile seed-setup-linux-x64",
    "build:macos": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile seed-setup-macos-x64",
    "build:macos-arm": "bun build src/index.ts --compile --target=bun-darwin-aarch64 --outfile seed-setup-macos-arm64",
    "build:all": "bun run build:linux && bun run build:macos && bun run build:macos-arm",
    "test": "bun test",
    "check": "bun --print 'import(\"./src/index.ts\")'"
  },
  "keywords": [
    "setup",
    "environment",
    "provisioning",
    "cli",
    "automation",
    "devops",
    "infrastructure"
  ],
  "author": "Ebowwa Labs <labs@ebowwa.com>",
  "license": "MIT",
  "homepage": "https://github.com/ebowwa/codespaces/tree/main/packages/src/seed/v2#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ebowwa/codespaces.git",
    "directory": "packages/src/seed/v2"
  },
  "bugs": {
    "url": "https://github.com/ebowwa/codespaces/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@ebowwa/bash-ops": "^1.0.1",
    "@ebowwa/terminal": "^0.3.0",
    "@ebowwa/codespaces-types": "^1.4.0",
    "@ebowwa/hetzner-mcp": "^1.2.2",
    "@ebowwa/tailscale": "^1.1.1",
    "@ebowwa/npm-publish-mcp": "^1.0.0",
    "@ebowwa/git-mcp": "^1.0.0",
    "@ebowwa/workspace-mcp": "^1.1.0",
    "@ebowwa/dependency-graph-mcp": "^1.0.0"
  }
}
